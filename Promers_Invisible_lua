local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- CONFIG
-- ============================================================
local PASTEL_FILL    = Color3.fromRGB(235, 200, 255)
local PASTEL_OUTLINE = Color3.fromRGB(240, 220, 255)
local TARGET_NAME    = "MengHub_InvisibilityFX"
local HOTKEY         = Enum.KeyCode.G
local INVIS_URL      = "https://leekguy.vercel.app/roblox/menghub/crack_obf_invisible_93978595733734.lua"

-- ============================================================
-- LOAD API
-- ============================================================
local InvisAPI = nil
local APIStatus = "loading..."

local function ValidateAPI(api)
    if type(api) ~= "table" then return false end
    if type(api.enable) ~= "function" then return false end
    if type(api.disable) ~= "function" then return false end
    return true
end

local function LoadAPI()
    if _G.MengHub and _G.MengHub.Invisible and ValidateAPI(_G.MengHub.Invisible) then
        InvisAPI = _G.MengHub.Invisible
        APIStatus = "OK (cached)"
        return true
    end
    local okFetch, src = pcall(function() return game:HttpGet(INVIS_URL) end)
    if not okFetch or not src then
        APIStatus = "HttpGet failed"
        return false
    end
    local fn, parseErr = loadstring(src)
    if not fn then
        APIStatus = "parse failed"
        return false
    end
    local okExec = pcall(fn)
    if not okExec then
        APIStatus = "exec failed"
        return false
    end
    task.wait(0.8)
    if _G.MengHub and _G.MengHub.Invisible and ValidateAPI(_G.MengHub.Invisible) then
        InvisAPI = _G.MengHub.Invisible
        APIStatus = "OK"
        return true
    end
    APIStatus = "_G.MengHub.Invisible missing"
    return false
end

-- ============================================================
-- INVIS STATE
-- ============================================================
local State = { Enabled = false, _lastToggle = 0, HookActive = false, PaintCount = 0, LastPaint = 0 }

local function CleanupTransparency()
    pcall(function()
        local chair = Workspace:FindFirstChild("invischair")
        if chair then chair:Destroy() end
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") or p:IsA("Decal") then
                    if p.Name ~= "Hurtbox" and p.Name ~= "HumanoidRootPart" and p.Name ~= "HRP_Clone" then
                        p.Transparency = 0
                        if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
                    end
                end
            end
        end
    end)
end

local function SetInvis(state)
    state = state and true or false
    if State.Enabled == state then return end
    local now = tick()
    if now - State._lastToggle < 0.3 then return end
    State._lastToggle = now
    if not InvisAPI then return end
    State.Enabled = state
    if state then
        pcall(function() InvisAPI.enable() end)
        print("[InvisPastel] Invis ON")
    else
        pcall(function() InvisAPI.disable() end)
        CleanupTransparency()
        print("[InvisPastel] Invis OFF")
    end
end

-- ============================================================
-- TECHNIQUE 1: HOOK __newindex (intercept set warna)
-- ============================================================
local function InstallNewIndexHook()
    if State.HookActive then return true end
    if type(hookmetamethod) ~= "function" then
        print("[InvisPastel] hookmetamethod not available")
        return false
    end
    if typeof(getrawmetatable) ~= "function" then
        print("[InvisPastel] getrawmetatable not available")
        return false
    end

    local ok = pcall(function()
        local mt = getrawmetatable(game)
        if setreadonly then setreadonly(mt, false) end

        local oldNewIndex = mt.__newindex

        mt.__newindex = newcclosure(function(self, key, value)
            if not checkcaller() and typeof(self) == "Instance" then
                local okName = pcall(function()
                    if self.Name == TARGET_NAME and self:IsA("Highlight") then
                        if key == "FillColor" then
                            return oldNewIndex(self, key, PASTEL_FILL)
                        elseif key == "OutlineColor" then
                            return oldNewIndex(self, key, PASTEL_OUTLINE)
                        end
                    end
                end)
            end
            return oldNewIndex(self, key, value)
        end)

        if setreadonly then setreadonly(mt, true) end
    end)

    if ok then
        State.HookActive = true
        print("[InvisPastel] ✅ __newindex hook installed")
        return true
    else
        print("[InvisPastel] ❌ hook install failed")
        return false
    end
end

-- ============================================================
-- TECHNIQUE 2: FALLBACK — destroy & recreate highlight
-- ============================================================
local replaceCooldown = {}
local function ReplaceHighlight(h)
    if not h or not h.Parent then return end
    local parent = h.Parent
    local adornee = h.Adornee
    local name = h.Name

    local key = tostring(parent) .. "|" .. name
    if replaceCooldown[key] and tick() - replaceCooldown[key] < 0.1 then return end
    replaceCooldown[key] = tick()

    pcall(function()
        h:Destroy()
        local new = Instance.new("Highlight")
        new.Name = name
        new.Adornee = adornee
        new.FillColor = PASTEL_FILL
        new.OutlineColor = PASTEL_OUTLINE
        new.FillTransparency = 0.7
        new.OutlineTransparency = 0.2
        new.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        new.Parent = parent
    end)
end

-- ============================================================
-- TECHNIQUE 3: FALLBACK — force set warna
-- ============================================================
local function ForcePaint()
    local count = 0
    local char = LocalPlayer.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Highlight") and d.Name == TARGET_NAME then
                count = count + 1
                if d.FillColor ~= PASTEL_FILL or d.OutlineColor ~= PASTEL_OUTLINE then
                    d.FillColor = PASTEL_FILL
                    d.OutlineColor = PASTEL_OUTLINE
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj ~= char then
            for _, d in ipairs(obj:GetChildren()) do
                if d:IsA("Highlight") and d.Name == TARGET_NAME then
                    count = count + 1
                    if d.FillColor ~= PASTEL_FILL then
                        d.FillColor = PASTEL_FILL
                        d.OutlineColor = PASTEL_OUTLINE
                    end
                end
            end
        end
    end
    return count
end

task.spawn(function()
    while true do
        task.wait(0.01)
        if State.Enabled then
            local c = ForcePaint()
            if c > 0 then
                State.PaintCount = c
                State.LastPaint = tick()
            end

            if not State.HookActive then
                local char = LocalPlayer.Character
                if char then
                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("Highlight") and d.Name == TARGET_NAME then
                            if d.FillColor ~= PASTEL_FILL then
                                ReplaceHighlight(d)
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ============================================================
-- HOOK DescendantAdded (instant catch)
-- ============================================================
Workspace.DescendantAdded:Connect(function(d)
    if d:IsA("Highlight") and d.Name == TARGET_NAME then
        task.defer(function()
            task.wait(0.01)
            if State.Enabled then
                pcall(function()
                    d.FillColor = PASTEL_FILL
                    d.OutlineColor = PASTEL_OUTLINE
                end)
            end
        end)
    end
end)

-- ============================================================
-- HOTKEY
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == HOTKEY then
        SetInvis(not State.Enabled)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if State.Enabled and InvisAPI then
        pcall(function() InvisAPI.enable() end)
    end
end)

-- ============================================================
-- AUTO START
-- ============================================================
task.spawn(function()
    local ok = LoadAPI()
    if not ok then
        warn("[InvisPastel] API FAIL: " .. APIStatus)
        return
    end
    InstallNewIndexHook()
    task.wait(0.3)
    SetInvis(true)
end)

